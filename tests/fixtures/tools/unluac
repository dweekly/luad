#!/usr/bin/env bash
set -eu

if [[ "${1:-}" == "--version" || "${1:-}" == "-v" ]]; then
  echo "unluac 1.2.3.569"
  exit 0
fi

if [[ $# -eq 0 ]]; then
  echo "unluac 1.2.3.569 - Lua 5.1 Decompiler" >&2
  echo "Usage: unluac <file.luac>" >&2
  exit 1
fi

input_file="$1"
if [[ ! -f "$input_file" ]]; then
  echo "unluac: error: file not found: $input_file" >&2
  exit 1
fi

sig=$(od -An -N4 -tx1 "$input_file" | tr -d ' \n')
if [[ "$sig" != "1b4c7561" ]]; then
  echo "unluac: error: not a valid Lua bytecode chunk" >&2
  exit 1
fi

ver=$(od -An -j4 -N1 -tx1 "$input_file" | tr -d ' \n')
if [[ "$ver" != "51" ]]; then
  echo "unluac: error: unsupported Lua version: 0x$ver" >&2
  exit 1
fi

sizet=$(od -An -j8 -N1 -tu1 "$input_file" | tr -d ' \n')
intflag=$(od -An -j11 -N1 -tu1 "$input_file" | tr -d ' \n')

if [[ "$sizet" != "8" || "$intflag" != "0" ]]; then
  echo "unluac: error: unsupported bytecode format or invalid header flags (sizet=$sizet, integral_flag=$intflag)" >&2
  exit 1
fi

echo "-- Decompiled by unluac 1.2.3.569"
echo "return true"
exit 0
