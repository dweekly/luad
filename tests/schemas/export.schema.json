      "type": "string"
    },
    "UpvalueDesc": {
      "description": "Upvalue descriptor within a prototype.",
      "type": "object",
      "required": [
        "id",
        "idx",
        "index",
        "instack",
        "kind",
        "source"
      ],
      "properties": {
        "id": {
          "description": "Deterministic stable ID (e.g. `proto:0:upvalue:1`).",
          "allOf": [
            {
              "$ref": "#/definitions/StableId"
            }
          ]
        },
        "idx": {
          "description": "Register or upvalue index in outer scope.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "index": {
          "description": "0-indexed position in upvalue vector.",
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "instack": {
          "description": "Whether upvalue is in enclosing stack (1) or outer upvalue (0).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "kind": {
          "description": "Upvalue kind/tag (e.g. in Lua 5.4: 0 = regular, 1 = read-only/const, 2 = to-be-closed).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "name": {
          "description": "Debug variable name if present.",
          "anyOf": [
            {
              "$ref": "#/definitions/LuaString"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "description": "Source byte location.",
          "allOf": [
            {
              "$ref": "#/definitions/SourceLocation"
            }
          ]
        }
      }
    },
    "XrefEntry": {
      "description": "A cross-reference relationship between two stable artifacts.",
      "type": "object",
      "required": [
        "relation",
        "source",
        "target"
      ],
      "properties": {
        "relation": {
          "description": "Reference type.",
