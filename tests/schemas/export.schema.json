            {
              "$ref": "#/definitions/XrefRelation"
            }
          ]
        },
        "source": {
          "description": "Originating artifact StableId (e.g. `proto:0:pc:4`).",
          "allOf": [
            {
              "$ref": "#/definitions/StableId"
            }
          ]
        },
        "target": {
          "description": "Referenced target StableId (e.g. `proto:0:k:2`, `proto:0:upvalue:0`).",
          "allOf": [
            {
              "$ref": "#/definitions/StableId"
            }
          ]
        }
      }
    },
    "XrefRelation": {
      "description": "Semantic nature of a reference.",
      "oneOf": [
        {
          "description": "Source reads from target.",
          "type": "string",
          "enum": [
            "reads"
          ]
        },
        {
          "description": "Source writes or mutates target.",
          "type": "string",
          "enum": [
            "writes"
          ]
        },
        {
          "description": "Source invokes or calls target function/closure.",
          "type": "string",
          "enum": [
            "calls"
          ]
        },
        {
          "description": "Source instantiates child prototype.",
          "type": "string",
          "enum": [
            "instantiates"
          ]
        },
        {
          "description": "Source branches or jumps to target instruction PC.",
          "type": "string",
          "enum": [
            "jumps-to"
          ]
        },
        {
          "description": "Parent closure instruction or binding descriptor binds to child upvalue.",
          "type": "string",
          "enum": [
            "binds"
          ]
        }
      ]
    }
  }
