    "test_cfg_alternatives_emit_alternatives_expression",
    "test_closure_argument_origin_emits_prototype_expression",
    "test_constant_key_table_literal_origins_emit_table_literal_expression",
    "test_every_call_and_fixed_argument_slot_has_exactly_one_fact",
    "test_export_origin_records_equal_direct_command",
    "test_lnum32_authority_chunk_pins_argument_level_origin_verdicts",
    "test_loop_carried_values_widen_rather_than_growing_without_bound",
    "test_open_argument_window_reports_its_determinable_prefix",
    "test_open_window_prefix_keeps_positions_rather_than_only_what_resolved",
    "test_open_window_with_no_determinable_prefix_reports_none",
    "test_origin_killer_mutations_are_rejected",
    "test_origin_matrix_histogram_and_cardinality_are_pinned",
    "test_origins_preserve_concat_mod_captures_and_explicit_stops",
    "test_origins_schema_capability_and_lnum_profile_are_public",
    "test_parameter_field_accesses_report_a_prototypes_input_contract",
    "test_parameter_fields_survive_the_streaming_paths_with_no_calls",
    "test_public_origins_json_jsonl_and_text_agree",
    "test_register_key_resolves_when_the_key_register_holds_a_literal",
    "test_sibling_closure_mutation_prevents_stale_capture_origin",
    "test_testset_branch_value_resolves_instead_of_reporting_overwritten",
    "test_testset_inside_a_concat_keeps_term_order_and_separators",
    "test_testset_skip_edge_does_not_reach_the_edge_that_assigns"
